{
  "name": "quizloom",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:staging": "node scripts/start-staging-server.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:avatars": "node scripts/avatar-reliability.mjs",
    "test:timer": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/timer-clock-regression.mjs",
    "test:multiplayer": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/multiplayer-state-regression.mjs",
    "test:host-leaderboard": "node scripts/host-leaderboard-regression.mjs",
    "test:improvements:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/multiplayer-improvements-unit.mjs",
    "test:performance:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/performance-instrumentation-unit.mjs",
    "test:benchmark-clock:unit": "node scripts/benchmark-clock-unit.mjs",
    "test:realtime-startup:unit": "node scripts/realtime-startup-unit.mjs",
    "test:backend-performance:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/backend-performance-unit.mjs",
    "test:staging-guard": "node scripts/staging-guard-unit.mjs",
    "test:improvements": "node scripts/multiplayer-improvements-regression.mjs",
    "test:migration-006": "node scripts/verify-migration-006.mjs",
    "test:migration-007": "node scripts/verify-migration-007.mjs",
    "test:migration-007:security": "node scripts/migration-007-security-unit.mjs",
    "test:migration-008": "node scripts/verify-migration-008.mjs",
    "test:migration-008:security": "node scripts/migration-008-security-unit.mjs",
    "test:migration-009:security": "node scripts/migration-009-security-unit.mjs",
    "test:migration-010:security": "node scripts/migration-010-security-unit.mjs",
    "test:migration-010": "node scripts/verify-migration-010.mjs",
    "test:migration-011:security": "node scripts/migration-011-security-unit.mjs",
    "test:migration-011": "node scripts/verify-migration-011.mjs",
    "test:quiz-deletion": "node scripts/quiz-deletion-regression.mjs",
    "test:phase-2d:reliability": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/phase-2d-reliability-unit.mjs",
    "test:performance": "node scripts/performance-benchmark.mjs --mode=optimized --players=2,10,20,50 --questions=6 --runs=3",
    "test:performance:direct": "node scripts/performance-benchmark.mjs --mode=optimized --delivery=direct --players=2,10,20,50 --questions=6 --runs=3"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.468.0",
    "next": "16.3.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.3.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
