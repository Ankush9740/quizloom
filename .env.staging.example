# Safety identity. Project refs are the subdomains in https://<project-ref>.supabase.co.
QUIZLOOM_ENVIRONMENT=staging
QUIZLOOM_STAGING_PROJECT_REF=your-staging-project-ref
QUIZLOOM_PRODUCTION_PROJECT_REF=your-production-project-ref
QUIZLOOM_ALLOW_STAGING_WRITES=I_ACKNOWLEDGE_THIS_DELETES_STAGING_DATA

# Application origin used by the benchmark. For a local staging-backed server:
QUIZLOOM_TEST_URL=http://127.0.0.1:3000

# Record the Supabase project region shown in its dashboard for result context.
QUIZLOOM_SUPABASE_REGION=your-staging-region

# Credentials from the isolated staging Supabase project only.
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-staging-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key
SESSION_TOKEN_PEPPER=replace-with-a-staging-only-long-random-secret
